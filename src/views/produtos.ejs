<html>
<head>
    <title>Gamer Store</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <div class="dashboard-header">

        <div>
            <h1>Gamer Store</h1>
            <p>Bem-vindo, <%= usuario %></p>
        </div>

        <div class="menu-botoes">
            <a class="btn" href="/pedidos">Pedidos</a>
            <a class="btn" href="/produtos/novo">+ Novo Produto</a>
            <a class="btn btn-sair" href="/logout">Sair</a>
        </div>

    </div>

    <div class="resumo">
        <div class="resumo-card">
            <h3>Produtos cadastrados</h3>
            <p><%= produtos.length %></p>
        </div>
    </div>

    <div class="grid-produtos">

        <% produtos.forEach(produto => { %>

            <div class="card">

                <h2><%= produto.nome %></h2>

                <p><b>Descrição:</b> <%= produto.descricao %></p>
                <p><b>Preço:</b> R$ <%= produto.preco %></p>
                <p><b>Estoque:</b> <%= produto.estoque %></p>
                <p><b>Categoria:</b> <%= produto.categoria %></p>

                <div class="acoes">
                    <a class="btn" href="/produtos/editar/<%= produto._id %>">
                        Editar
                    </a>

                    <form action="/produtos/deletar/<%= produto._id %>" method="POST">
                        <button class="btn-danger" type="submit">Excluir</button>
                    </form>
                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>