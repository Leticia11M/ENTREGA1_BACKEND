<html>
<head>
    <title>Login Gamer Store</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="login-container">

    <div class="login-card">

        <h1>Login Gamer Store</h1>

        <form action="/login" method="POST">

            <label>Email:</label>

            <input
                type="email"
                name="email"
                required
            >

            <label>Senha:</label>

            <input
                type="password"
                name="senha"
                required
            >

            <button
                class="login-btn"
                type="submit"
            >
                Acessar Sistema
            </button>

        </form>

    </div>

</div>

</body>
</html>