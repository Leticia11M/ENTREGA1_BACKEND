<html>
<head>
    <title>Pedidos</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <div class="dashboard-header">

        <div>
            <h1>Pedidos</h1>
            <p>Bem-vindo, <%= usuario %></p>
        </div>

        <div class="menu-botoes">
            <a class="btn" href="/produtos">Produtos</a>
            <a class="btn" href="/pedidos/novo">+ Novo Pedido</a>
            <a class="btn btn-sair" href="/logout">Sair</a>
        </div>

    </div>

    <div class="resumo">
        <div class="resumo-card">
            <h3>Pedidos cadastrados</h3>
            <p><%= pedidos.length %></p>
        </div>
    </div>

    <div class="grid-produtos">

        <% pedidos.forEach(pedido => { %>

            <div class="card">

                <h2>Pedido</h2>

                <p><b>Cliente:</b> <%= pedido.cliente %></p>
                <p><b>Produtos:</b> <%= pedido.produtos %></p>
                <p><b>Valor total:</b> R$ <%= pedido.valorTotal %></p>
                <p><b>Status:</b> <%= pedido.status %></p>

                <div class="acoes">

                    <a class="btn" href="/pedidos/editar/<%= pedido.id %>">
                        Editar
                    </a>

                    <form action="/pedidos/deletar/<%= pedido.id %>" method="POST">
                        <button class="btn-danger" type="submit">
                            Excluir
                        </button>
                    </form>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>