<html>
<head>
    <title>Editar Produto</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <div class="form-container">

        <h1>Editar Produto</h1>

        <form action="/produtos/editar/<%= produto._id %>" method="POST">

            <label>Nome:</label>
            <input
                type="text"
                name="nome"
                value="<%= produto.nome %>"
            >

            <label>Descrição:</label>
            <input
                type="text"
                name="descricao"
                value="<%= produto.descricao %>"
            >

            <label>Preço:</label>
            <input
                type="number"
                name="preco"
                value="<%= produto.preco %>"
            >

            <label>Estoque:</label>
            <input
                type="number"
                name="estoque"
                value="<%= produto.estoque %>"
            >

            <label>Categoria:</label>
            <input
                type="text"
                name="categoria"
                value="<%= produto.categoria %>"
            >

            <button type="submit">
                Atualizar Produto
            </button>

        </form>

        <a class="btn" href="/produtos">
            Voltar
        </a>

    </div>

</div>

</body>
</html>